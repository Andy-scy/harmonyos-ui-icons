 * Iconsax 图标目录（由 skills/harmonyos-ui-icons/scripts/fetch-icons.mjs 自动生成）
 * 图标文件位于 resources/rawfile/iconsax/<style>/<name>.svg
 */

export interface IconMeta {
  name: string;
  label: string;
}

export class IconsaxCatalog {
  static readonly STYLES: string[] = ['bold', 'broken', 'bulk', 'linear', 'outline', 'twotone'];
  /** 用 fill 画的样式；其余用 stroke 画，上色方式不同 */
  private static readonly FILL_STYLES: string[] = ['bold', 'bulk', 'outline'];

  static isStrokeStyle(style: string): boolean {
    return !IconsaxCatalog.FILL_STYLES.includes(style);
  }

