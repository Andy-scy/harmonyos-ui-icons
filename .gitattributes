# Normalize line endings so the repo behaves the same on Windows / macOS / Linux
* text=auto eol=lf

# Windows scripting hosts prefer CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.hap binary
*.har binary
*.p12 binary
*.cer binary
*.p7b binary
