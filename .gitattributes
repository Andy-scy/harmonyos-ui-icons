# Normalize line endings so the repo behaves the same on Windows / macOS / Linux
* text=auto eol=lf

# Windows scripting hosts prefer CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.hap binary
*.har binary
*.hsp binary
*.p12 binary
*.cer binary
*.p7b binary

# SVG stays text: the only .svg committed here is the hand-written plugin icon
# (icon.svg). The Iconsax artwork is gitignored and never enters the object store,
# so there is nothing binary to protect.
*.svg text eol=lf
